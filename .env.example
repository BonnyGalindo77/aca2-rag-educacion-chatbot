# Copie este archivo como .env y complete los valores. NUNCA suba el .env al repositorio.
# Qdrant Cloud → cloud.qdrant.io → clúster aca1-cun → "Cluster URL" y "API Keys"
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=pegue-aqui-su-api-key-de-qdrant
# Google AI Studio → aistudio.google.com/apikey (la misma del ACA 1)
GOOGLE_API_KEY=pegue-aqui-su-api-key-de-google

# Opcionales (valores por defecto)
QDRANT_COLLECTION=aca1_educacion_permanencia
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.5-flash
SCORE_THRESHOLD=0.645
TOP_K=5
# Clave para habilitar la carga/retiro de documentos desde la app (si no se define, la carga queda deshabilitada)
ADMIN_PASSWORD=cambie-esta-clave
